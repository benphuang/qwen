# Shared settings, sourced by the other scripts. Edit for your server.
export QWEN_ROOT="${QWEN_ROOT:-$HOME/qwen-local}"
export HF_HOME="${HF_HOME:-$QWEN_ROOT/hf}"      # needs ~100 GB free for all three variants
export ENV_NAME="${ENV_NAME:-qwen-vllm}"
export PORT="${PORT:-8000}"
export KEY_FILE="${KEY_FILE:-$HOME/.config/qwen-local/api_key}"
export SERVED_NAME="${SERVED_NAME:-qwen3.8-27b}"

# Checkpoint per precision. NVFP4/MXFP4 builds are Blackwell-only; A4000 is Ampere (sm_86).
declare -A MODEL_ID=(
  [bf16]="Qwen/Qwen3.8-27B"
  [fp8]="Qwen/Qwen3.8-27B-FP8"             # weight-only FP8 on Ampere (Marlin), no FP8 compute speedup
  [int4]="RedHatAI/Qwen3.8-27B-INT4"       # W4A16, group size 128
)
